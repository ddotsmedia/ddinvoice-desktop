    "/customers": {
      "post": {
        "operationId": "CustomersController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "nameEn": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "nameAr": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "trn": {
                    "type": "string",
                    "pattern": "^\\d{15}$"
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "phone": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 32
                  },
                  "addressEn": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "addressAr": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "emirate": {
                    "type": "string",
                    "enum": [
                      "ABU_DHABI",
                      "DUBAI",
                      "SHARJAH",
                      "AJMAN",
                      "UMM_AL_QUWAIN",
                      "RAS_AL_KHAIMAH",
                      "FUJAIRAH"
                    ]
                  },
                  "country": {
                    "default": "AE",
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2
                  },
                  "currency": {
                    "default": "AED",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3
                  },
                  "paymentTermsDays": {
                    "default": 30,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 365
                  },
                  "creditLimit": {
                    "type": "string",
                    "pattern": "^\\d{1,14}(\\.\\d{1,4})?$"
                  },
                  "receivableAccountId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "required": [
                  "code",
                  "nameEn",
                  "nameAr",
                  "email",
                  "phone",
                  "addressEn",
                  "addressAr",
                  "receivableAccountId"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "customers"
        ]
