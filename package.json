{
  "name": "ddinvoice-desktop",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:libs": "pnpm -r --filter \"./packages/*\" build",
    "test": "vitest run --passWithNoTests && pnpm --filter @ddinvoice/db test",
    "lint": "eslint .",
    "typecheck": "pnpm build:libs && pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.10",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
