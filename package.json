{
  "name": "ddinvoice-desktop",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:libs": "pnpm -r --filter \"./packages/*\" build",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "pnpm build:libs && pnpm -r typecheck",
    "vendor": "tsx tools/scripts/fetch-postgres.ts && tsx tools/scripts/fetch-node.ts && tsx tools/scripts/fetch-winsw.ts && tsx tools/scripts/fetch-chrome.ts",
    "bundle:server": "tsx tools/scripts/bundle-server.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.10",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-i18next": "6.1.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
