generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id        String  @id @default(uuid())
  companyId String
  email     String
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, email])
  @@index([companyId])
}
